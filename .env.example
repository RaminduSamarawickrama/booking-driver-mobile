# Copy to .env (git-ignored). Values are baked in at bundle time; never put secrets here.
# On a phone, localhost is the phone itself: use your computer's LAN IP or a tunnel URL.
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.20:8080
# false hides the in-app backend switcher (release builds)
EXPO_PUBLIC_ALLOW_API_OVERRIDE=true
